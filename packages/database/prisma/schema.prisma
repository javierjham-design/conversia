model SchedulingConnection {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  clinicId       String?                @map("clinic_id")
  provider       SchedulingProviderKind
  status         String                 @default("active")
  config         Json                   @default("{}")
  credentialId   String?                @map("credential_id")
  lastSyncAt     DateTime?              @map("last_sync_at")
  lastError      String?                @map("last_error")
  createdAt      DateTime               @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("scheduling_connections")
}

// --------------------------- Workflows ---------------------------

model Workflow {
  id               String            @id @default(cuid())
  organizationId   String            @map("organization_id")
  clinicId         String?           @map("clinic_id")
  name             String
  description      String?
  active           Boolean           @default(false)
  currentVersionId String?           @map("current_version_id")
  templateKey      String?           @map("template_key")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  versions         WorkflowVersion[]

  @@index([organizationId])
  @@map("workflows")
}

// definition Json = { trigger, nodes[], edges[], variables{} }
// (fusiona workflow_nodes / workflow_edges / workflow_variables:
//  el editor visual serializa el grafo completo versionado)
model WorkflowVersion {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  workflowId     String        @map("workflow_id")
  version        Int
  status         PublishStatus @default(DRAFT)
  definition     Json
  changelog      String?
  createdById    String?       @map("created_by_id")
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  workflow       Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([organizationId])
  @@map("workflow_versions")
}

model WorkflowRun {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  workflowId     String            @map("workflow_id")
  versionId      String            @map("version_id")
  status         WorkflowRunStatus @default(RUNNING)
  contactId      String?           @map("contact_id")
  conversationId String?           @map("conversation_id")
  triggerEvent   Json              @default("{}") @map("trigger_event")
  variables      Json              @default("{}")
  currentNodeId  String?           @map("current_node_id")
  error          String?
  idempotencyKey String?           @map("idempotency_key")
  startedAt      DateTime          @default(now()) @map("started_at")
  finishedAt     DateTime?         @map("finished_at")
  steps          WorkflowRunStep[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([organizationId, conversationId])
  @@map("workflow_runs")
}

model WorkflowRunStep {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  runId          String      @map("run_id")
  nodeId         String      @map("node_id")
  nodeType       String      @map("node_type")
  status         StepStatus  @default(PENDING)
  attempt        Int         @default(1)
  input          Json        @default("{}")
  output         Json        @default("{}")
  error          String?
  startedAt      DateTime    @default(now()) @map("started_at")
  finishedAt     DateTime?   @map("finished_at")
  run            WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId, runId])
  @@map("workflow_run_steps")
}

// Timers persistentes (esperas de workflows, recordatorios, seguimientos).
// Fuente de verdad en Postgres; el worker los sondea y encola.
model ScheduledJob {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  kind           String // workflow_timer | reminder | follow_up | …
  runId          String?            @map("run_id")
  payload        Json               @default("{}")
  dueAt          DateTime           @map("due_at")
  status         ScheduledJobStatus @default(PENDING)
  uniqueKey      String?            @map("unique_key")
  createdAt      DateTime           @default(now()) @map("created_at")
  processedAt    DateTime?          @map("processed_at")

  @@unique([organizationId, uniqueKey])
  @@index([status, dueAt])
  @@map("scheduled_jobs")
}

// ------------------------- Integraciones -------------------------

// Conexión genérica de integración por tenant (una fila por org+provider).
// providers en uso: email | api_presets | ga4 | zapier | make | google | hubspot
// (la agenda va en scheduling_connections y Meta/WhatsApp en sus modelos).
model IntegrationConnection {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  clinicId       String?   @map("clinic_id")
  provider       String
  status         String    @default("active") // active | error | reauthorize
  config         Json      @default("{}")
  credentialId   String?   @map("credential_id")
  lastSyncAt     DateTime? @map("last_sync_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("integration_connections")
}

// Credenciales cifradas AES-256-GCM por tenant (nunca en claro)
model IntegrationCredential {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  provider       String
  label          String?
  ciphertext     String // base64(iv || tag || data)
  keyVersion     Int       @default(1) @map("key_version")
  createdAt      DateTime  @default(now()) @map("created_at")
  rotatedAt      DateTime? @map("rotated_at")

  @@index([organizationId, provider])
  @@map("integration_credentials")
}

// Webhook ENTRANTE por tenant: URL pública /hooks/t/{token} que dispara el
// trigger "Webhook entrante" de workflows (Make/Zapier/landings → Conversia).
model InboundWebhook {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  name             String
  token            String    @unique // segmento de la URL pública
  secretCiphertext String?   @map("secret_ciphertext") // HMAC opcional (cifrado)
  active           Boolean   @default(true)
  lastReceivedAt   DateTime? @map("last_received_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("inbound_webhooks")
}

// API key por tenant para la API pública de Conversia (solo hash en reposo).
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  prefix         String // visible en el panel (cnvk_xxxx…)
  hash           String    @unique @map("key_hash") // sha256 del secreto completo
  scopes         Json      @default("[]")
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("api_keys")
}

model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  clinicId       String?  @map("clinic_id")
  name           String
  description    String?
  url            String
  secret         String // para firmar HMAC salidas
  events         Json     @default("[]")
  headers        Json     @default("{}") // headers personalizados
  timeoutMs      Int      @default(10000) @map("timeout_ms")
  maxRetries     Int      @default(4) @map("max_retries")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  endpointId     String                @map("endpoint_id")
  event          String
  payload        Json                  @default("{}")
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseCode   Int?                  @map("response_code")
  lastError      String?               @map("last_error")
  nextRetryAt    DateTime?             @map("next_retry_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([organizationId, status])
  @@map("webhook_deliveries")
}

// ------------------------- Ecosistema Meta -------------------------

enum MetaConnectionMode {
  EMBEDDED // Embedded Signup oficial (requiere app aprobada por Meta)
  MANUAL // ids + token de sistema cargados manualmente
  MOCK // simulación de desarrollo — SIEMPRE visible como tal en la UI
}

enum MetaConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

// Conexión Meta del tenant (una por organización en v1)
model MetaBusinessConnection {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  status         MetaConnectionStatus @default(PENDING)
  mode           MetaConnectionMode   @default(MANUAL)
  businessId     String?              @map("business_id")
  businessName   String?              @map("business_name")
  appScopes      Json                 @default("[]") @map("app_scopes")
  credentialId   String?              @map("credential_id")
  connectedById  String?              @map("connected_by_id")
  lastError      String?              @map("last_error")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([organizationId])
  @@map("meta_business_connections")
}

// Activos de Meta del tenant: páginas, ad accounts, WABA, números,
// instagram, datasets y formularios de Lead Ads (kind=lead_form).
model MetaAsset {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  connectionId   String   @map("connection_id")
  kind           String // page | ad_account | waba | phone_number | instagram | dataset | lead_form
  externalId     String   @map("external_id")
  name           String
  enabled        Boolean  @default(true)
  meta           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, kind, externalId])
  @@map("meta_assets")
}

// Mapeo campo Meta → campo Conversia por formulario (null = default)
model MetaFieldMapping {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  formExternalId String?  @map("form_external_id")
  mappings       Json     @default("[]") // [{source, target}]
  config         Json     @default("{}") // {clinicId, teamId, agentSlug, leadStatusCode, tags[], workflowTemplateKey}
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, formExternalId])
  @@map("meta_field_mappings")
}

// Reglas evento Conversia → evento Meta (Conversions API)
model MetaEventMapping {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  datasetId      String?  @map("dataset_id")
  testEventCode  String?  @map("test_event_code")
  rules          Json     @default("[]") // [{source, dest, value, currency, active, dedup}]
  active         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId])
  @@map("meta_event_mappings")
}

// Catálogo de anuncios de Meta por organización (campaña → conjunto → anuncio).
// Plano y denormalizado: cada fila es un anuncio con el nombre de su campaña y
// conjunto, para armar el árbol del trigger y resolver ad_id→campaña en runtime.
// Cacheado; se sincroniza a diario + "Sincronizar ahora". Anuncios borrados en
// Meta se marcan available=false (no se eliminan: pueden estar en flujos vivos).
model MetaAd {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  adAccountId    String   @map("ad_account_id") // external act_...
  campaignId     String   @map("campaign_id")
  campaignName   String   @map("campaign_name")
  adsetId        String   @map("adset_id")
  adsetName      String   @map("adset_name")
  adExternalId   String   @map("ad_external_id") // el ad_id que llega en el referral
  adName         String   @map("ad_name")
  status         String // ACTIVE | PAUSED | ARCHIVED | …
  objective      String? // objetivo de la campaña
  isCtwa         Boolean  @default(false) @map("is_ctwa") // lleva a WhatsApp (Click-to-WhatsApp)
  available      Boolean  @default(true) // false = ya no está en Meta
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, adExternalId])
  @@index([organizationId, campaignId])
  @@map("meta_ads")
}

// Actividad/logs de integraciones (payloads SIEMPRE sanitizados)
model IntegrationEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  provider       String // meta | whatsapp | clariva | webhook | capi | lead_ads
  type           String // lead.received | capi.sent | webhook.delivered | sync.ok | …
  status         String   @default("ok") // ok | warning | error
  message        String?
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, provider, createdAt])
  @@map("integration_events")
}

// Estados OAuth (CSRF) para flujos de conexión oficiales
model OAuthState {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  provider       String
  state          String    @unique
  redirectUri    String    @map("redirect_uri")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("oauth_states")
}

// ------------------------- Operación / auditoría -------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id") // null = acción de plataforma
  actorType      String   @map("actor_type") // user | agent | system | platform_admin
  actorId        String?  @map("actor_id")
  action         String // p.ej. conversation.takeover, agent.publish, appointment.create
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// Registro por request de IA: modelo, tokens, costo, latencia (sección 39)
model AiRequest {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  agentId        String?   @map("agent_id")
  agentVersionId String?   @map("agent_version_id")
  conversationId String?   @map("conversation_id")
  workflowRunId  String?   @map("workflow_run_id")
  provider       String
  model          String
  purpose        AiPurpose @default(CHAT)
  inputTokens    Int       @default(0) @map("input_tokens")
  outputTokens   Int       @default(0) @map("output_tokens")
  costUsd        Decimal   @default(0) @map("cost_usd") @db.Decimal(12, 6)
  latencyMs      Int?      @map("latency_ms")
  status         String    @default("ok") // ok | error | refusal
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("ai_requests")
}

model SystemAlert {
  id             String        @id @default(cuid())
  organizationId String?       @map("organization_id")
  severity       AlertSeverity @default(INFO)
  type           String
  message        String
  meta           Json          @default("{}")
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("system_alerts")
}

model File {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  clinicId       String?  @map("clinic_id")
  bucket         String?
  // clave con prefijo por tenant: {organizationId}/...
  key            String
  name           String
  mime           String?
  size           Int?
  uploadedById   String?  @map("uploaded_by_id")
  scope          String? // message | knowledge | branding | export
  // Binario base64 (SOLO lo lee el endpoint que sirve la imagen; jamás en listados)
  content        String?
  meta           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("files")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  type           String
  title          String
  body           String?
  meta           Json      @default("{}")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

// Dispositivos de push por usuario. GENÉRICA: soporta Web Push (endpoint+claves)
// y push nativo (token APNs/FCM) sin migración futura — el nativo solo llena
// identifier+platform+kind. Un usuario puede tener varios; todos reciben.
model PushDevice {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  platform       String // web | ios | android | desktop
  kind           String // web_push | apns | fcm
  identifier     String // endpoint de Web Push  ó  token nativo
  keys           Json     @default("{}") // { p256dh, auth } en Web Push; vacío en nativo
  label          String? // "Chrome en Windows", "iPhone de Javier"
  active         Boolean  @default(true)
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, identifier])
  @@index([organizationId, userId, active])
  @@map("push_devices")
}

// Registro de entregas: una fila por (evento, destinatario, canal, dispositivo).
// Para soporte: "no me llegó el aviso" se responde con datos, no teorías.
model NotificationDelivery {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  eventKey       String   @map("event_key")
  channel        String // in_app | web_push | email | native_push | whatsapp
  deviceId       String?  @map("device_id")
  status         String // queued | sent | failed | skipped
  error          String?
  meta           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, createdAt])
  @@map("notification_deliveries")
}

// Bolsa de mensajes prepagada por organización. La exposición máxima por cliente
// = su saldo (lo que ya pagó). Débito atómico y previo al envío. Ver
// docs/PREPAID_WALLET_DESIGN.md.
model MessageWallet {
  id                String   @id @default(cuid())
  organizationId    String   @unique @map("organization_id")
  balance           Int      @default(0) // créditos disponibles
  includedPerPeriod Int      @default(0) @map("included_per_period") // snapshot del plan al renovar
  carryoverCap      Int      @default(0) @map("carryover_cap") // tope de acumulación (= 1 mes)
  periodStart       DateTime @default(now()) @map("period_start")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("message_wallets")
}

// Libro de movimientos de la bolsa: append-only, fuente de verdad auditable.
model WalletLedger {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  delta          Int // + acredita, − descuenta
  reason         String // plan_renewal | package_purchase | send_debit | refund | admin_adjust
  balanceAfter   Int      @map("balance_after")
  category       String? // utility | marketing | authentication (en send_debit)
  costUsd        Decimal? @map("cost_usd") @db.Decimal(12, 6) // costo real Meta del envío (margen)
  refType        String?  @map("ref_type") // message | invoice | package | admin
  refId          String?  @map("ref_id")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, refType, refId])
  @@map("wallet_ledger")
}

// Catálogo de paquetes adicionales — editable desde el Super Admin, sin redeploy.
model MessagePackage {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  credits  Int
  priceClp Int     @map("price_clp")
  priceUsd Decimal @map("price_usd") @db.Decimal(10, 2)
  active   Boolean @default(true)
  order    Int     @default(0)

  @@map("message_packages")
}

// Exports de datos en background (BullMQ). El archivo expira a los 7 días y
// la descarga requiere permiso de Datos; queda registro de quién exportó.
model ExportJob {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  type           String // contacts | conversations | appointments
  params         Json      @default("{}") // { from, to }
  status         String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  content        String? // CSV generado (se borra al expirar)
  rows           Int?
  error          String?
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  finishedAt     DateTime? @map("finished_at")
  expiresAt      DateTime? @map("expires_at")

  @@index([organizationId, createdAt])
  @@map("export_jobs")
}

// Biblioteca de plantillas de prompt del tenant (editor de agentes y compositor)
model PromptTemplate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  body           String
  type           String   @default("instructions") // instructions | indications | tone | policy | script
  agentIds       Json     @default("[]") @map("agent_ids") // [] = todos los agentes
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("prompt_templates")
}
