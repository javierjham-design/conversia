model ProfessionalService {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  professionalId String @map("professional_id")
  serviceId      String @map("service_id")

  @@unique([organizationId, professionalId, serviceId])
  @@map("professional_services")
}

model Appointment {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  clinicId       String?                @map("clinic_id")
  contactId      String                 @map("contact_id")
  professionalId String?                @map("professional_id")
  serviceId      String?                @map("service_id")
  provider       SchedulingProviderKind @default(MOCK)
  externalId     String?                @map("external_id") // id en el proveedor de agenda
  status         AppointmentStatus      @default(PENDING)
  startsAt       DateTime               @map("starts_at")
  endsAt         DateTime               @map("ends_at")
  timezone       String                 @default("America/Santiago")
  conversationId String?                @map("conversation_id")
  notes          String?
  meta           Json                   @default("{}")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  contact        Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId, startsAt])
