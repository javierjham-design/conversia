// =============================================================
// Conversia — Esquema multi-tenant
// Regla: toda tabla de datos de tenant lleva `organization_id`.
// sql/setup.sql agrega dinámicamente FKs a organizations(id) y
// políticas RLS sobre TODA tabla con columna organization_id.
// Merges documentados en docs/DATA_MODEL.md (p.ej. internal_notes
// → messages.visibility, workflow_nodes/edges → definition Json).
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [vector]
}

// ----------------------------- Enums -----------------------------

enum OrgStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ChannelType {
  WHATSAPP_CLOUD
  MOCK
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  VIDEO
  LOCATION
  CONTACTS
  STICKER
  REACTION
  TEMPLATE
  INTERACTIVE
  SYSTEM
  NOTE
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageVisibility {
  PUBLIC
  INTERNAL
}

enum AuthorType {
  CONTACT
  USER
  AGENT
  SYSTEM
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeadStatusCategory {
  OPEN
  WON
  LOST
  FROZEN
}

enum WorkflowRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ScheduledJobStatus {
  PENDING
  PROCESSING
  DONE
  CANCELLED
  FAILED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED
  COMPLETED
  NO_SHOW
}

enum SchedulingProviderKind {
  MOCK
  CLARIVA
  DENTALINK
  GOOGLE_CALENDAR
  CUSTOM
}

enum HandoffStatus {
  PENDING
  ACTIVE
  RESOLVED
  RETURNED_TO_AI
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AiPurpose {
  CHAT
  CLASSIFY
  EXTRACT
  SUMMARIZE
  EMBED
  TRANSCRIBE
  MODERATE
  EVALUATE
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// ------------------------ Nivel plataforma ------------------------

model PlatformAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  // RBAC de plataforma: owner (todo) | admin | support | billing | readonly
  role         String    @default("owner")
  // MFA TOTP (RFC 6238). El secreto es durable; las sesiones viven en Redis.
  mfaSecret       String?   @map("mfa_secret")
  mfaEnabledAt    DateTime? @map("mfa_enabled_at")
  mfaRecoveryCodes Json     @default("[]") @map("mfa_recovery_codes")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("platform_admins")
}

// CRM de prospectos/demos de la plataforma (TuBot). Distinto de los "leads" del
// tenant. Se crea desde la web ("Empezar"/"Solicitar demo") y se gestiona en el
// super admin. Al provisionar el demo se enlaza organizationId.
model DemoLead {
  id             String    @id @default(cuid())
  name           String
  email          String
  company        String?
  phone          String?
  planInterest   String?   @map("plan_interest")
  status         String    @default("NEW") // NEW | CONTACTED | PROVISIONED | ACTIVE | WON | LOST
  organizationId String?   @map("organization_id")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("demo_leads")
}

// Ajustes globales de plataforma (clave-valor). Los secretos (credenciales de
// pasarelas) se guardan CIFRADOS (AES-256-GCM) y nunca se devuelven al frontend.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model Plan {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  // Límites por plan: usuarios, sedes, canales, agentes, workflows,
  // ejecuciones/mes, aiTokensDaily, contactos, almacenamiento, etc.
  limits    Json     @default("{}")
  features  Json     @default("{}")
  priceUsd  Decimal  @default(0) @map("price_usd") @db.Decimal(10, 2)
  priceClp  Decimal  @default(0) @map("price_clp") @db.Decimal(12, 0)
  interval  String   @default("monthly") // monthly | yearly
  trialDays Int      @default(0) @map("trial_days")
  isPublic  Boolean  @default(true) @map("is_public")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("plans")
}

// Cupón de descuento (lo crea el super admin, se aplica en el checkout). Encaja
// con la estrategia de landings por campaña. Platform-level (cliente admin).
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String    @map("discount_type") // PERCENT | FIXED
  discountValue  Decimal   @map("discount_value") @db.Decimal(12, 2)
  currency       String? // requerido si FIXED (CLP/USD); null si PERCENT
  maxRedemptions Int?      @map("max_redemptions")
  timesRedeemed  Int       @default(0) @map("times_redeemed")
  expiresAt      DateTime? @map("expires_at")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

// Idempotencia de webhooks de pago: garantiza no procesar dos veces el mismo
// evento (reintentos de Stripe/Flow → no duplicar activaciones/facturas).
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String // stripe | flow
  eventId     String   @map("event_id")
  type        String?
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

// Factura de la plataforma hacia el tenant (cobro por uso de Conversia).
model Invoice {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  subscriptionId String?       @map("subscription_id")
  number         String // CONV-2026-000123
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("CLP")
  amountDue      Decimal       @map("amount_due") @db.Decimal(12, 2)
  lines          Json          @default("[]")
  periodStart    DateTime?     @map("period_start")
  periodEnd      DateTime?     @map("period_end")
  dueAt          DateTime?     @map("due_at")
  paidAt         DateTime?     @map("paid_at")
  provider       String        @default("mock")
  providerRef    String?       @map("provider_ref")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("invoices")
}

// Método de pago del tenant. NUNCA se guardan datos de tarjeta: sólo el
// token/referencia del proveedor (Stripe, etc.) y metadatos no sensibles.
model PaymentMethod {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  provider       String   @default("mock")
  kind           String // card | transfer | manual
  brand          String?
  last4          String?
  providerRef    String?  @map("provider_ref")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("payment_methods")
}

// Identidad global de usuario (puede pertenecer a varias organizaciones)
model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String             @map("password_hash")
  name         String
  phone        String?
  locale       String             @default("es")
  lastLoginAt  DateTime?          @map("last_login_at")
  // MFA (TOTP): secreto cifrado AES-256-GCM, códigos de recuperación hasheados.
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecret        String?   @map("mfa_secret")
  mfaRecoveryCodes Json      @default("[]") @map("mfa_recovery_codes")
  mfaEnrolledAt    DateTime? @map("mfa_enrolled_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  memberships  OrganizationUser[]

  @@map("users")
}

// --------------------------- Tenant core ---------------------------

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  status    OrgStatus @default(TRIAL)
  country   String    @default("CL")
  timezone  String    @default("America/Santiago")
  locale    String    @default("es")
  currency  String    @default("CLP")
  // Branding/white-label: logo, colores, dominio, mensajes institucionales…
  settings  Json      @default("{}")
  planId    String?   @map("plan_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("organizations")
}

// Tickets de soporte in-app: el tenant reporta un problema y el Super Admin lo ve.
// Estructura pensada para, a futuro, ENRUTAR los tickets a la bandeja de TuBot
// (cuando TuBot sea tenant de sí mismo): guarda el tenant de origen, el usuario
// que reporta, el contacto asociado si aplica y a qué conversación aterrizó.
model SupportTicket {
  id                   String    @id @default(cuid())
  organizationId       String    @map("organization_id") // tenant de origen
  userId               String?   @map("user_id") // usuario que reportó (puede ser null)
  contactId            String?   @map("contact_id") // contacto asociado, si aplica
  email                String? // correo de contacto para responder
  subject              String?
  message              String
  url                  String? // página desde donde se reportó
  status               String    @default("open") // open | resolved
  // Conversación donde se atendió el ticket (futuro: bandeja de TuBot-tenant).
  routedConversationId String?   @map("routed_conversation_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  resolvedAt           DateTime? @map("resolved_at")

  @@index([organizationId])
  @@index([status, createdAt])
  @@map("support_tickets")
}

model OrganizationDomain {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  domain         String   @unique
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("organization_domains")
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  planId         String             @map("plan_id")
  status         SubscriptionStatus @default(TRIALING)
  // Ítems/addons del plan (subscription_items fusionado)
  items          Json               @default("[]")
  periodStart    DateTime?          @map("period_start")
  periodEnd      DateTime?          @map("period_end")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("subscriptions")
}

// Registro de consumo por tenant (tokens, mensajes, ejecuciones…)
model UsageEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  type           String // ai_tokens | whatsapp_message | workflow_run | conversation | storage
  quantity       Decimal  @default(1) @db.Decimal(14, 4)
  costUsd        Decimal? @map("cost_usd") @db.Decimal(12, 6)
  meta           Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at")

  @@index([organizationId, type, occurredAt])
  @@map("usage_events")
}

// Sede (clinic/branch). Una organización puede tener varias.
model Clinic {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  slug           String
  address        String?
  city           String?
  timezone       String    @default("America/Santiago")
  // Horarios de atención, teléfono, instrucciones de llegada, etc.
  settings       Json      @default("{}")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("clinics")
}

// Rol configurable por organización. permissions = lista de strings
// "module:action" (fusiona permissions y role_permissions).
model Role {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  code           String // owner | admin | supervisor | operator | viewer | custom…
  name           String
  permissions    Json     @default("[]")
  system         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, code])
  @@map("roles")
}

model OrganizationUser {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_users")
}

// Acceso de un usuario a sedes específicas (vacío = toda la organización)
model ClinicUser {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  clinicId       String @map("clinic_id")
  userId         String @map("user_id")

  @@unique([organizationId, clinicId, userId])
  @@map("clinic_users")
}

model Team {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  clinicId       String?      @map("clinic_id")
  name           String
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at")
  members        TeamMember[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  teamId         String @map("team_id")
  userId         String @map("user_id")
  team           Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([organizationId])
  @@map("team_members")
}

// ------------------------ Contactos y leads ------------------------

model Contact {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  clinicId       String?   @map("clinic_id")
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  phone          String?
  email          String?
  documentId     String?   @map("document_id")
  birthDate      DateTime? @map("birth_date")
  locale         String    @default("es")
  timezone       String?
  isReturning    Boolean   @default(false) @map("is_returning")
  // consentimiento de contacto / no contactar
  consent        Boolean   @default(true)
  doNotContact   Boolean   @default(false) @map("do_not_contact")
  blocked        Boolean   @default(false)
  source         String?
  campaignId     String?   @map("campaign_id")
  // Nombre de perfil de WhatsApp (contacts[].profile.name) — SEPARADO del
  // nombre real (firstName/lastName): nunca lo pisa; se refresca si Meta cambia.
  profileName       String?   @map("profile_name")
  // País ISO inferido del prefijo telefónico (CL, PE…) para tabla/filtros.
  country           String?
  // Fuente de creación del contacto: webhook | manual | import | api.
  createdVia        String    @default("webhook") @map("created_via")
  // Cómo llegó: "organic" | "ad" (para segmentar orgánicos vs anuncios).
  acquisitionSource String?   @map("acquisition_source")
  // Atribución Click-to-WhatsApp: ad id + click id (para CAPI y reportes).
  adId              String?   @map("ad_id")
  ctwaClid          String?   @map("ctwa_clid")
  // Payload crudo del referral/contacto de Meta — no perder nada a futuro.
  meta           Json      @default("{}")
  // atributos flexibles + resumen IA + preferencias + objeciones
  attributes     Json      @default("{}")
  firstContactAt DateTime? @map("first_contact_at")
  lastContactAt  DateTime? @map("last_contact_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  identities    ContactIdentity[]
  conversations Conversation[]
  leads         Lead[]
  appointments  Appointment[]

  @@index([organizationId, phone])
  @@index([organizationId, lastContactAt])
  @@index([organizationId, createdAt])
  @@map("contacts")
}

// Segmentos = filtros guardados por tenant (aparecen en el sidebar de Contactos).
// definition = JSON de condiciones evaluado en BD (mismo lenguaje que los filtros).
model ContactSegment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  definition     Json     @default("{}")
  isDefault      Boolean  @default(false) @map("is_default")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("contact_segments")
}

// Identidad por canal (wa_id, ig_id, etc.). Resuelve contacto entrante.
model ContactIdentity {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  contactId      String      @map("contact_id")
  channelType    ChannelType @map("channel_type")
  externalId     String      @map("external_id")
  contact        Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channelType, externalId])
  @@map("contact_identities")
}

model CustomFieldDefinition {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  entity         String // contact | lead | conversation | appointment
  key            String
  label          String
  type           String // text | number | date | select | multiselect | boolean | phone | email | url
  options        Json     @default("[]")
  required       Boolean  @default(false)
  order          Int      @default(0) // orden en la ficha
  showInList     Boolean  @default(false) @map("show_in_list") // columna disponible en Contactos
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, entity, key])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  definitionId   String @map("definition_id")
  entityId       String @map("entity_id")
  value          Json

  @@unique([organizationId, definitionId, entityId])
  @@map("custom_field_values")
}

// Estados de lead configurables por tenant (sección 8 del brief)
model LeadStatus {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  code           String
  name           String
  category       LeadStatusCategory @default(OPEN)
  color          String?
  emoji          String? // icono visible en bandeja/selectores (estilo Respond.io)
  active         Boolean            @default(true) // desactivar sin borrar (no aparece en selectores)
  order          Int                @default(0)
  system         Boolean            @default(false)
  leads          Lead[]

  @@unique([organizationId, code])
  @@map("lead_statuses")
}

model Lead {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  clinicId       String?     @map("clinic_id")
  contactId      String      @map("contact_id")
  statusId       String      @map("status_id")
  serviceId      String?     @map("service_id")
  campaignId     String?     @map("campaign_id")
  ownerUserId    String?     @map("owner_user_id")
  teamId         String?     @map("team_id")
  score          Int?
  // motivo de consulta, urgencia, objeciones, próxima acción…
  meta           Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  contact        Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status         LeadStatus  @relation(fields: [statusId], references: [id])
  events         LeadEvent[]

  @@index([organizationId, statusId])
  @@index([organizationId, contactId])
  @@map("leads")
}

model LeadEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  leadId         String   @map("lead_id")
  type           String // status_changed | note | assigned | appointment_created | …
  data           Json     @default("{}")
  actorType      String?  @map("actor_type") // user | agent | system | workflow
  actorId        String?  @map("actor_id")
  createdAt      DateTime @default(now()) @map("created_at")
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, createdAt])
  @@map("lead_events")
}

model Campaign {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  source         String? // meta_ads | google | organic | referral | … (fusiona tabla sources)
  externalId     String?  @map("external_id") // id de campaña/anuncio en Meta
  active         Boolean  @default(true)
  meta           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("campaigns")
}

model Tag {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  name           String
  color          String?

  @@unique([organizationId, name])
  @@map("tags")
}

// Asignación polimórfica de etiquetas (contactos, conversaciones, leads)
model TagAssignment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  tagId          String   @map("tag_id")
  entityType     String   @map("entity_type") // contact | conversation | lead
  entityId       String   @map("entity_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, tagId, entityType, entityId])
  @@index([organizationId, entityType, entityId])
  @@map("tag_assignments")
}

// --------------------------- Canales ---------------------------

model ChannelConnection {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  clinicId       String?     @map("clinic_id")
  type           ChannelType
  name           String
  status         String      @default("active")
  // configuración del canal: horario, mensaje fuera de horario, etc.
  config         Json        @default("{}")
  defaultAgentId String?     @map("default_agent_id")
  defaultTeamId  String?     @map("default_team_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("channel_connections")
}

model WhatsappAccount {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  wabaId         String                @map("waba_id")
  businessId     String?               @map("business_id")
  name           String
  credentialId   String?               @map("credential_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  phoneNumbers   WhatsappPhoneNumber[]

  @@unique([organizationId, wabaId])
  @@map("whatsapp_accounts")
}

// Cada número identifica al tenant en los webhooks entrantes.
model WhatsappPhoneNumber {
  id                  String          @id @default(cuid())
  organizationId      String          @map("organization_id")
  accountId           String          @map("account_id")
  channelConnectionId String?         @map("channel_connection_id")
  clinicId            String?         @map("clinic_id")
  phoneNumberId       String          @unique @map("phone_number_id") // id de Meta
  displayPhone        String          @map("display_phone")
  status              String          @default("active")
  routing             Json            @default("{}")
  account             WhatsappAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("whatsapp_phone_numbers")
}

model WhatsappTemplate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  accountId      String   @map("account_id")
  name           String
  language       String
  category       String // MARKETING | UTILITY | AUTHENTICATION
  status         String   @default("PENDING") // según Meta
  body           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, accountId, name, language])
  @@map("whatsapp_templates")
}

// ------------------------ Conversaciones ------------------------

model Conversation {
  id                  String             @id @default(cuid())
  organizationId      String             @map("organization_id")
  clinicId            String?            @map("clinic_id")
  contactId           String             @map("contact_id")
  channelConnectionId String?            @map("channel_connection_id")
  status              ConversationStatus @default(OPEN)
  assignedUserId      String?            @map("assigned_user_id")
  assignedTeamId      String?            @map("assigned_team_id")
  activeAgentId       String?            @map("active_agent_id")
  aiEnabled           Boolean            @default(true) @map("ai_enabled")
  unreadCount         Int                @default(0) @map("unread_count")
  lastMessageAt       DateTime?          @map("last_message_at")
  lastMessagePreview  String?            @map("last_message_preview")
  // resumen IA, intención, sentimiento, urgencia, próxima acción, datos extraídos
  meta                Json               @default("{}")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  contact             Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages            Message[]

  @@index([organizationId, status, lastMessageAt])
  @@index([organizationId, contactId])
  // Conteos del clasificador de la Bandeja (por agente IA / por equipo)
  @@index([organizationId, activeAgentId])
  @@index([organizationId, assignedTeamId])
  @@map("conversations")
}

// Bandejas personalizadas: filtros guardados sobre conversaciones (patrón contact_segments)
model InboxView {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  // { channelId?, statusCode?, tags?, assigned?, hasAd?, status? }
  definition     Json     @default("{}")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("inbox_views")
}

// Respuestas rápidas del compositor (atajo "/")
model Snippet {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  shortcut       String
  body           String
  scope          String   @default("team") // team | mine (solo el creador)
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, shortcut])
  @@index([organizationId])
  @@map("snippets")
}

// Indicaciones del equipo para la IA en UNA conversación. El orquestador las
// inyecta en cada turno de esa conversación (prioridad sobre el prompt base,
// nunca sobre las reglas de seguridad del sistema). Historial quién/cuándo.
model ConversationAiNote {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  conversationId String    @map("conversation_id")
  body           String
  active         Boolean   @default(true)
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  deactivatedAt  DateTime? @map("deactivated_at")

  @@index([organizationId, conversationId, active])
  @@map("conversation_ai_notes")
}

// internal_notes fusionado: type=NOTE + visibility=INTERNAL
model Message {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  conversationId String              @map("conversation_id")
  direction      MessageDirection
  type           MessageType         @default(TEXT)
  visibility     MessageVisibility   @default(PUBLIC)
  body           String?
  // payload crudo del canal (media ids, ubicación, interactive, template usada…)
  payload        Json                @default("{}")
  externalId     String?             @map("external_id") // wamid — idempotencia
  status         MessageStatus       @default(PENDING)
  error          String?
  authorType     AuthorType          @map("author_type")
  authorUserId   String?             @map("author_user_id")
  agentId        String?             @map("agent_id")
  agentVersionId String?             @map("agent_version_id")
  aiRequestId    String?             @map("ai_request_id")
  sentAt         DateTime?           @map("sent_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]

  @@unique([organizationId, externalId])
  @@index([organizationId, conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  messageId      String  @map("message_id")
  fileId         String? @map("file_id")
  kind           String // image | audio | document | video
  url            String?
  mime           String?
  message        Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("message_attachments")
}

// --------------------------- Agentes IA ---------------------------

// Plantillas: globales (organization_id null) o privadas del tenant
model AgentTemplate {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  industry       String? // dental | medical | aesthetics | services | generic
  name           String
  description    String?
  systemPrompt   String   @map("system_prompt")
  config         Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("agent_templates")
}

model Agent {
  id               String         @id @default(cuid())
  organizationId   String         @map("organization_id")
  clinicId         String?        @map("clinic_id") // null = toda la organización
  templateId       String?        @map("template_id")
  slug             String
  name             String
  description      String?
  kind             String         @default("custom") // receptionist | orchestrator | sales | scheduler | follow_up | …
  active           Boolean        @default(true)
  currentVersionId String?        @map("current_version_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")
  versions         AgentVersion[]

  @@unique([organizationId, slug])
  @@map("agents")
}

// Versionado de agentes/prompts (sección 11)
model AgentVersion {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  agentId        String        @map("agent_id")
  version        Int
  status         PublishStatus @default(DRAFT)
  systemPrompt   String        @map("system_prompt")
  // model, temperature, maxTokens, idioma, tono, límites de costo,
  // criterios de transferencia/escalamiento, datos obligatorios, etc.
  config         Json          @default("{}")
  // nombres de tools habilitadas para esta versión
  tools          Json          @default("[]")
  changelog      String?
  createdById    String?       @map("created_by_id")
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([organizationId])
  @@map("agent_versions")
}

// Asignación de agentes a ámbitos (canal, sede, campaña, workflow)
model AgentAssignment {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  agentId        String @map("agent_id")
  scopeType      String @map("scope_type") // channel | clinic | campaign | workflow
  scopeId        String @map("scope_id")
  priority       Int    @default(0)

  @@unique([organizationId, agentId, scopeType, scopeId])
  @@map("agent_assignments")
}

// Transferencias entre agentes (conserva contexto — sección 12)
model AgentHandoff {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  conversationId String   @map("conversation_id")
  fromAgentId    String?  @map("from_agent_id")
  toAgentId      String?  @map("to_agent_id")
  reason         String?
  contextSummary String?  @map("context_summary")
  data           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, conversationId])
  @@map("agent_handoffs")
}

// Escalamiento a humanos (sección 7 y 30)
model HumanHandoff {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  conversationId String        @map("conversation_id")
  requestedBy    String        @map("requested_by") // agent | contact | rule | user
  reason         String?
  status         HandoffStatus @default(PENDING)
  userId         String?       @map("user_id")
  teamId         String?       @map("team_id")
  takenAt        DateTime?     @map("taken_at")
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([organizationId, status])
  @@map("human_handoffs")
}

model ApprovalRequest {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  conversationId String?        @map("conversation_id")
  type           String // discount | mass_send | sensitive_info | schedule_change | …
  payload        Json           @default("{}")
  requestedById  String?        @map("requested_by_id") // agentId o userId
  status         ApprovalStatus @default(PENDING)
  approverUserId String?        @map("approver_user_id")
  comment        String?
  expiresAt      DateTime?      @map("expires_at")
  resolvedAt     DateTime?      @map("resolved_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([organizationId, status])
  @@map("approval_requests")
}

// ------------------------ Base de conocimiento ------------------------

model KnowledgeBase {
