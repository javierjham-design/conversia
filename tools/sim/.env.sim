# Entorno de SIMULACIÓN para el stack Docker (tools/sim/docker-compose.sim.yml).
# NO es producción. Proveedores en mock, claves de PRUEBA. Lo consumen api/worker/conversia-web.
# Las URLs de BD por servicio se fijan en el compose (admin para db-init, conversia_app para api/worker).

NODE_ENV=production
REDIS_URL=redis://redis:6379

# Proveedores en mock (cero llamadas externas reales).
AI_PROVIDER=mock
EMBEDDINGS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
SCHEDULING_PROVIDER=mock
# SOLO SIMULACIÓN: este stack corre con NODE_ENV=production y las jornadas (sim250, e2e
# "como el dueño") contratan planes/packs por `POST /billing/mock-confirm`. En producción
# ese endpoint está bloqueado SIEMPRE salvo este interruptor (auditoría §9.5) — y aun
# encendido se bloquea si hay pasarela real configurada (acá no hay ninguna). JAMÁS en prod.
BILLING_MOCK_ENABLED=true

# SOLO SIMULACIÓN (auditoría §1.3): `db:seed` ahora ABORTA con NODE_ENV=production, porque
# siembra un tenant de demo + un super admin y pisa el catálogo de planes — un `pnpm db:seed`
# con el DATABASE_URL de prod en la terminal equivocada alcanzaba para hacerlo. Este stack
# corre con NODE_ENV=production a propósito y su base es desechable (`conversia_sim`, que se
# crea y se bota con el compose), así que acá SÍ se quiere sembrar y se pide explícitamente.
# Las contraseñas van explícitas porque el seed ya no tiene valores por defecto.
ALLOW_PROD_SEED=true
SEED_ADMIN_PASSWORD=sim-admin-no-usar-en-prod
PLATFORM_ADMIN_PASSWORD=sim-platform-no-usar-en-prod

# Secretos NO-default (si fueran los default, el boot-guard de producción tumba api/worker).
# Valores de PRUEBA — jamás usar en prod.
JWT_SECRET=sim-jwt-secret-no-usar-en-prod-0123456789abcdef
CREDENTIALS_ENCRYPTION_KEY=1111111111111111111111111111111111111111111111111111111111111111
MOCK_INBOUND_TOKEN=dev-mock-inbound-token
SUPER_ADMIN_SESSION_SECRET=sim-super-admin-secret
META_VERIFY_TOKEN=sim-verify-token

# URLs internas del compose (el navegador en el host usa localhost:4000 / :3002).
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3002
# Config de NAVEGADOR (F2/F3): localhost:3002 = marca conversia (brandFromOrigin por
# hostname). Para la regresión de marca con sim250 (node-client) se usa app.conversia.cl.
WEB_URL_CONVERSIA=http://localhost:3002

# Pool acotado (stack chico).
DB_CONNECTION_LIMIT=10

# SOLO SIMULACIÓN: límites por-IP altos para que sim250 (250 altas desde una IP) no choque
# con el antiabuso (el fuse por-tenant se mantiene). En prod rigen los defaults.
LOGIN_MAX_PER_WINDOW=100000
API_MAX_PER_MINUTE=100000
MSG_CAP_SVC_GLOBAL_DAY=2000000
MSG_CAP_SVC_PER_TENANT_DAY=3000

# Web Push (VAPID) — claves de PRUEBA generadas para el sim. Las de PRODUCCIÓN van en
# Railway (ver RUNBOOK_GOLIVE_V2.md); NUNCA reutilizar estas en prod.
VAPID_PUBLIC_KEY=BDCmmRW7_BsRqGKsScUZwAa1fp_1kHgvzjDyfjedcqkgVpnOlyMOQaj1uOz8DjCR9k7frFj95l0-6LHW8zEjXBg
VAPID_PRIVATE_KEY=OMzFYGKdZKv3tonEWHQk5eYoOX1vJEVQhtPJY55L5DA
VAPID_SUBJECT=mailto:sim@conversia.local

# SOLO SIMULACIÓN: la carga de push (tools/sim/push-load.mjs) usa un mock HTTPS self-signed;
# web-push exige TLS. Esto deja que el worker acepte ese cert de prueba. JAMÁS en prod.
NODE_TLS_REJECT_UNAUTHORIZED=0
