# Entorno de SIMULACIÓN para el stack Docker (tools/sim/docker-compose.sim.yml).
# NO es producción. Proveedores en mock, claves de PRUEBA. Lo consumen api/worker/conversia-web.
# Las URLs de BD por servicio se fijan en el compose (admin para db-init, conversia_app para api/worker).

NODE_ENV=production
REDIS_URL=redis://redis:6379

# Proveedores en mock (cero llamadas externas reales).
AI_PROVIDER=mock
EMBEDDINGS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
SCHEDULING_PROVIDER=mock

# Secretos NO-default (si fueran los default, el boot-guard de producción tumba api/worker).
# Valores de PRUEBA — jamás usar en prod.
JWT_SECRET=sim-jwt-secret-no-usar-en-prod-0123456789abcdef
CREDENTIALS_ENCRYPTION_KEY=1111111111111111111111111111111111111111111111111111111111111111
MOCK_INBOUND_TOKEN=sim-mock-inbound-token
SUPER_ADMIN_SESSION_SECRET=sim-super-admin-secret
META_VERIFY_TOKEN=sim-verify-token

# URLs internas del compose (el navegador en el host usa localhost:4000 / :3002).
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3002
WEB_URL_CONVERSIA=http://localhost:3002

# Pool acotado (stack chico).
DB_CONNECTION_LIMIT=10

# Web Push (VAPID) — claves de PRUEBA generadas para el sim. Las de PRODUCCIÓN van en
# Railway (ver RUNBOOK_GOLIVE_V2.md); NUNCA reutilizar estas en prod.
VAPID_PUBLIC_KEY=BDCmmRW7_BsRqGKsScUZwAa1fp_1kHgvzjDyfjedcqkgVpnOlyMOQaj1uOz8DjCR9k7frFj95l0-6LHW8zEjXBg
VAPID_PRIVATE_KEY=OMzFYGKdZKv3tonEWHQk5eYoOX1vJEVQhtPJY55L5DA
VAPID_SUBJECT=mailto:sim@conversia.local
